generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean       @default(false)
  createdAt     DateTime      @default(now())
  isCashier     Boolean       @default(false)
  password      String?
  updatedAt     DateTime      @default(now())
  accounts      Account[]
  CashOrder     CashOrder[]
  CashSession   CashSession[]
  comments      Comment[]
  orders        Orders[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id            String          @id @default(cuid())
  createdAt     DateTime        @default(now())
  title         String
  desc          String
  img           String?
  price         Decimal
  isFeatured    Boolean
  isVisible     Boolean
  options       Json[]
  catSlug       String
  CashOrderItem CashOrderItem[]
}

model Orders {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  price         Decimal
  products      Json[]
  status        String   @default("pending")
  intent_id     String?  @unique
  userEmail     String?
  source        String   @default("online")
  customerName  String?
  amountPaid    Decimal?
  changeGiven   Decimal?
  paymentMethod String?  @default("cash")
  notes         String?
  user          User?    @relation(fields: [userEmail], references: [email], onDelete: Restrict)

  @@index([status, createdAt])
}

model Comment {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  userEmail  String
  title      String
  comment    String
  ratingWeb  Int
  ratingFood Int
  user       User     @relation(fields: [userEmail], references: [email])
}

model CashOrder {
  id            String          @id
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  totalAmount   Decimal
  status        String          @default("completed")
  paymentType   String          @default("cash")
  userId        String
  cashGiven     Decimal?
  change        Decimal?
  sessionId     String?
  CashSession   CashSession?    @relation(fields: [sessionId], references: [id])
  User          User            @relation(fields: [userId], references: [id])
  CashOrderItem CashOrderItem[]
}

model CashOrderItem {
  id        String    @id
  orderId   String
  productId String
  quantity  Int
  price     Decimal
  options   Json?
  CashOrder CashOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Product   Product   @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
}

model CashSession {
  id           String      @id
  userId       String
  startTime    DateTime    @default(now())
  endTime      DateTime?
  startingCash Decimal
  endingCash   Decimal?
  totalSales   Decimal     @default(0)
  isActive     Boolean     @default(true)
  notes        String?
  CashOrder    CashOrder[]
  User         User        @relation(fields: [userId], references: [id])
}
